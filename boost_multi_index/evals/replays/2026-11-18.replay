answer	int ahead(const Store& s, std::uint64_t id) {\n    auto it = s.project<ByBook>(s.get<ById>().find(id));\n    auto first = s.get<ByBook>().lower_bound(std::make_tuple(it->side, it->price));\n    return int(std::distance(first, it));\n}
