answer	bool set_cl_ord_id(Store& s, std::uint64_t id, std::uint32_t v) {\n    auto& ix = s.get<0>();\n    auto it = ix.find(id);\n    if (it == ix.end()) return false;\n    std::uint32_t old = it->cl_ord_id;\n    return ix.modify(it, [v](Order& o) { o.cl_ord_id = v; }, [old](Order& o) { o.cl_ord_id = old; });\n}
